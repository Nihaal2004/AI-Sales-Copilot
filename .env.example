# Existing process environment variables take precedence over .env.
# Default adapter: Gemini Developer API with native tool calling.
LLM_PROVIDER=google_genai
LLM_MODEL=gemini-3.5-flash-lite
GOOGLE_API_KEY=
# Gemini 3 reasoning level: low keeps CRM tool selection responsive.
GEMINI_THINKING_LEVEL=low
# GEMINI_API_KEY is also supported; GOOGLE_API_KEY takes precedence if both are set.
# For Anthropic: install .[anthropic], set LLM_PROVIDER=anthropic,
# LLM_MODEL to your available tool-calling model, and ANTHROPIC_API_KEY.
# For OpenAI: install .[openai], set LLM_PROVIDER=openai,
# LLM_MODEL to your available tool-calling model, and OPENAI_API_KEY.
CRM_DB_PATH=data/crm.sqlite3
MAX_AGENT_STEPS=8

# Optional metadata-only LangSmith export. Disabled unless BOTH are set.
# Generic LANGSMITH_TRACING is deliberately suppressed around Copilot execution.
SALES_COPILOT_LANGSMITH=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sales-copilot
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Only used by the separate Ragas judge command with --allow-llm-judge.
# Set explicitly to a Gemini model available to your account. No default judge.
RAGAS_JUDGE_MODEL=
